# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Object storage (LocalStack S3 locally, AWS S3 in production)
# Host is the Compose service name — never localhost
STORAGE_ENDPOINT=http://storage:4566
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube
STORAGE_BUCKET=streamtube
# Multipart part size in bytes (S3 minimum is 5 MiB)
STORAGE_PART_SIZE_BYTES=104857600
STORAGE_UPLOAD_URL_TTL_SECONDS=3600
STORAGE_READ_URL_TTL_SECONDS=900
STORAGE_ABORT_INCOMPLETE_UPLOAD_DAYS=1

# Processing queue (BullMQ over Redis)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=5000
